# Almanac configuration — the installer fills this in.

# Admin credential (seeded into the DB on first login; change requires
# clearing site_config admin_* rows or a future admin UI)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SQLite location (mounted volume in Docker)
DATABASE_PATH=./data/almanac.db

# Metadata sources
TMDB_API_KEY=          # themoviedb.org → Settings → API
TWITCH_CLIENT_ID=      # dev.twitch.tv console — for IGDB
TWITCH_CLIENT_SECRET=
OMDB_API_KEY=          # omdbapi.com — optional, IMDb/Rotten Tomatoes ratings

# Public site URL (OG tags, absolute links)
SITE_URL=http://localhost:3000
